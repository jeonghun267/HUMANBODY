  m_Script: {fileID: 11500000, guid: b1aa7e2a222a6da4ea51d68c0ab9aa66, type: 3}
  m_Name: Stage_Lobby
  m_EditorClassIdentifier: Assembly-CSharp::OrganStage
  stageId: Lobby
  displayName: "\uC778\uCCB4 \uD0D0\uD5D8\uAD00 \uB85C\uBE44"
  sceneName: 00_Lobby
  introLines:
  - text: "\uC548\uB155! \uB098\uB294 \uBCD1\uC544\uB9AC \uC758\uC0AC \uC090\uC57D\uC774\uC57C.
      \uC624\uB298 \uB108\uB294 \uB098\uC640 \uD568\uAED8 \uBAB8\uC18D\uC744 \uC0B4\uD3B4\uBCFC
      \uD0D0\uD5D8\uAC00\uC57C."
    voice: {fileID: 8300000, guid: 99ac1a0ef4d5686459db87fb9396e567, type: 3}
    holdSeconds: 5.85
  - text: "\uC804\uC2DC\uB300 \uC704\uC758 \uAE30\uAD00\uC744 \uAC00\uB9CC\uD788
      \uBC14\uB77C\uBCF4\uBA74 \uC124\uBA85\uC774 \uB098\uC640. \uB2E4 \uB458\uB7EC\uBD24\uC73C\uBA74
      \uC800\uAE30 \uCEE4\uB2E4\uB780 \uC785 \uBAA8\uC591 \uC785\uAD6C\uB85C \uB4E4\uC5B4\uC640!"
    voice: {fileID: 8300000, guid: e073661c4d1caa1438fcc784ed498db1, type: 3}
    holdSeconds: 7.2799997
  outroLines:
  - text: "\uC900\uBE44\uB410\uC9C0? \uC774 \uC785\uAD6C\uB97C \uC9C0\uB098 \uC544\uC8FC
      \uC791\uC740 \uD0D0\uD5D8\uAC00\uAC00 \uB418\uC5B4 \uBCF4\uC790. \uC74C\uC2DD\uC774
      \uC9C0\uB098\uAC00\uB294 \uAE38\uC744 \uB530\uB77C \uC785\uBD80\uD130 \uB300\uC7A5\uAE4C\uC9C0
      \uD568\uAED8 \uD0D0\uD5D8\uD560 \uAC70\uC57C. \uCD9C\uBC1C!"
    voice: {fileID: 8300000, guid: 2d4c479105d4fe549984f71a505f9931, type: 3}
    holdSeconds: 9.23
  summary: "\uC18C\uD654\uB294 \uC74C\uC2DD\uC774 \uBAB8\uC5D0 \uD761\uC218\uB420
    \uC218 \uC788\uC744 \uB9CC\uD07C \uC544\uC8FC \uC791\uAC8C \uCABC\uAC1C\uC9C0\uB294
    \uACFC\uC815\uC774\uC5D0\uC694. \uC785\uC5D0\uC11C \uC2DC\uC791\uD574 \uC2DD\uB3C4,
    \uC704, \uC18C\uC7A5, \uB300\uC7A5\uC744 \uCC28\uB840\uB85C \uC9C0\uB098\uC694."
  funFacts:
  - "\uC18C\uD654\uAD00 \uC804\uCCB4 \uAE38\uC774\uB294 \uC57D 9\uBBF8\uD130\uB098
    \uB3FC\uC694."
  - "\uC74C\uC2DD\uC774 \uBAB8\uC744 \uB2E4 \uD1B5\uACFC\uD558\uB294 \uB370 \uD558\uB8E8\uC5D0\uC11C
    \uC774\uD2C0\uC774 \uAC78\uB824\uC694."
  - "\uC18C\uD654\uB97C \uB3D5\uB294 \uAC04, \uCDCC\uC7A5, \uC4F8\uAC1C\uB294 \uC74C\uC2DD\uC774
    \uC9C0\uB098\uAC00\uC9C0\uB294 \uC54A\uC9C0\uB9CC \uC18C\uD654\uC561\uC744 \uBCF4\uB0B4
    \uC918\uC694."
  fadeColor: {r: 0.043137256, g: 0.0627451, b: 0.1254902, a: 1}
  ridesCapsule: 0
