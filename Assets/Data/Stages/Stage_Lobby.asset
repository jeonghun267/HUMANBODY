  displayName: "\uBCD1\uC6D0 \uC9C4\uB8CC\uC2E4"
  sceneName: 00_Lobby
  introLines:
  - text: "\uC778\uCCB4\uD0D0\uD5D8\uC5D0 \uC628 \uAC78 \uD658\uC601\uD574! \uC5EC\uAE30\uB294
      \uBCD1\uC6D0\uC774\uC57C. \uC811\uC218\uB300\uC758 \uAC04\uD638\uC0AC \uC120\uC0DD\uB2D8\uAED8
      \uB2E4\uAC00\uAC00 \uBD10!"
    voice: {fileID: 8300000, guid: 99ac1a0ef4d5686459db87fb9396e567, type: 3}
    holdSeconds: 5.85
  outroLines:
  - text: "\uC7A0\uC218\uC815\uC774 \uC544\uC8FC\uC544\uC8FC \uC791\uC544\uC9C0\uBA74\uC11C
      \uB124 \uC785\uC18D\uC73C\uB85C \uB4E4\uC5B4\uAC08 \uAC70\uC57C. \uCD9C\uBC1C!"
    voice: {fileID: 8300000, guid: 2d4c479105d4fe549984f71a505f9931, type: 3}
    holdSeconds: 4.42
  summary: "\uC18C\uD654\uB294 \uC74C\uC2DD\uC774 \uBAB8\uC5D0 \uD761\uC218\uB420
    \uC218 \uC788\uC744 \uB9CC\uD07C \uC544\uC8FC \uC791\uAC8C \uCABC\uAC1C\uC9C0\uB294
    \uACFC\uC815\uC774\uC5D0\uC694. \uC785\uC5D0\uC11C \uC2DC\uC791\uD574 \uC2DD\uB3C4,
    \uC704, \uC18C\uC7A5, \uB300\uC7A5\uC744 \uCC28\uB840\uB85C \uC9C0\uB098\uC694."
  funFacts:
  - "\uC18C\uD654\uAD00 \uC804\uCCB4 \uAE38\uC774\uB294 \uC57D 9\uBBF8\uD130\uB098
    \uB3FC\uC694."
  - "\uC74C\uC2DD\uC774 \uBAB8\uC744 \uB2E4 \uD1B5\uACFC\uD558\uB294 \uB370 \uD558\uB8E8\uC5D0\uC11C
    \uC774\uD2C0\uC774 \uAC78\uB824\uC694."
  - "\uC18C\uD654\uB97C \uB3D5\uB294 \uAC04, \uCDCC\uC7A5, \uC4F8\uAC1C\uB294 \uC74C\uC2DD\uC774
    \uC9C0\uB098\uAC00\uC9C0\uB294 \uC54A\uC9C0\uB9CC \uC18C\uD654\uC561\uC744 \uBCF4\uB0B4
    \uC918\uC694."
  fadeColor: {r: 0.043137256, g: 0.0627451, b: 0.1254902, a: 1}
  ridesCapsule: 0
