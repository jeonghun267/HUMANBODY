  m_Script: {fileID: 11500000, guid: b1aa7e2a222a6da4ea51d68c0ab9aa66, type: 3}
  m_Name: Stage_SmallIntestine
  m_EditorClassIdentifier: Assembly-CSharp::OrganStage
  stageId: SmallIntestine
  displayName: "\uC18C\uC7A5"
  sceneName: 04_SmallIntestine
  introLines:
  - text: "\uC18C\uC7A5\uC740 \uAE38\uC774\uAC00 6~7\uBBF8\uD130\uB098 \uB418\uACE0,
      \uC601\uC591\uC18C \uB300\uBD80\uBD84\uC774 \uD761\uC218\uB418\uB294 \uACF3\uC774\uC57C.
      \uD0D0\uD5D8 \uCEA1\uC290\uC744 \uD0C0\uACE0 \uD761\uC218 \uACFC\uC815\uC744
      \uC0B4\uD3B4\uBCF4\uC790."
    voice: {fileID: 8300000, guid: 022c0722189a90f4ea06bfd004998505, type: 3}
    holdSeconds: 7.7999997
  - text: "\uBCBD\uC5D0 \uB09C \uC190\uAC00\uB77D \uBAA8\uC591 \uB3CC\uAE30 '\uC735\uD138'\uC774
      \uD45C\uBA74\uC801\uC744 \uC5C4\uCCAD\uB098\uAC8C \uB113\uD600 \uC918. \uB2E4
      \uD3B4\uBA74 \uD14C\uB2C8\uC2A4 \uCF54\uD2B8\uB9CC \uD574!"
    voice: {fileID: 8300000, guid: c06fbe39ac35d1c4db13b74416d47a8c, type: 3}
    holdSeconds: 6.7599998
  outroLines:
  - text: "\uB0A8\uC740 \uCC0C\uAEBC\uAE30\uC640 \uBB3C\uC740 \uB300\uC7A5\uC73C\uB85C
      \uB118\uC5B4\uAC00. \uC6B0\uB9AC\uB294 \uD0D0\uD5D8 \uCEA1\uC290\uC744 \uD0C0\uACE0
      \uADF8 \uB4A4\uB97C \uB530\uB77C\uAC00 \uBCF4\uC790!"
    voice: {fileID: 8300000, guid: 86acfc2b7a51c0844967c9ebba6c4780, type: 3}
    holdSeconds: 6.1099997
  summary: "\uC18C\uC7A5\uC740 \uCDCC\uC7A5\uC561\uACFC \uC4F8\uAC1C\uC999\uC73C\uB85C
    \uC601\uC591\uC18C\uB97C \uC644\uC804\uD788 \uBD84\uD574\uD558\uACE0, \uC735\uD138\uC744
    \uD1B5\uD574 \uD3EC\uB3C4\uB2F9\xB7\uC544\uBBF8\uB178\uC0B0\xB7\uC9C0\uBC29\uC0B0\uC744
    \uD761\uC218\uD574\uC694."
  funFacts:
  - "\uC735\uD138\uC740 1\uBC00\uB9AC\uBBF8\uD130 \uC815\uB3C4\uB85C \uC544\uC8FC
    \uC791\uC9C0\uB9CC \uC218\uBC31\uB9CC \uAC1C\uB098 \uC788\uC5B4\uC694."
  - "\uCDCC\uC7A5\uC740 \uC18C\uD654 \uD6A8\uC18C\uB97C, \uAC04\uC740 \uC9C0\uBC29\uC744
    \uB179\uC774\uB294 \uC4F8\uAC1C\uC999\uC744 \uC18C\uC7A5\uC73C\uB85C \uBCF4\uB0B4\uC694."
  - "\uC18C\uC7A5\uC740 \uC2ED\uC774\uC9C0\uC7A5, \uACF5\uC7A5, \uD68C\uC7A5 \uC138
    \uBD80\uBD84\uC73C\uB85C \uB098\uB258\uC5B4\uC694."
  fadeColor: {r: 0.2901961, g: 0.11764706, b: 0.13333334, a: 1}
  ridesCapsule: 1
