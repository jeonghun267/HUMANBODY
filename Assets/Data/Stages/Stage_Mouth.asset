  m_Script: {fileID: 11500000, guid: b1aa7e2a222a6da4ea51d68c0ab9aa66, type: 3}
  m_Name: Stage_Mouth
  m_EditorClassIdentifier: Assembly-CSharp::OrganStage
  stageId: Mouth
  displayName: "\uC785"
  sceneName: 01_Mouth
  introLines:
  - text: "\uB3C4\uCC29! \uC5EC\uAE30\uB294 \uB124 \uC785\uC18D\uC774\uC57C. \uC7A0\uC218\uC815\uC5D0\uC11C
      \uB0B4\uB824\uC11C \uD600 \uC704\uB97C \uAC78\uC5B4 \uBCF4\uC790."
    voice: {fileID: 8300000, guid: 2a8431a77e7411b478f10a04120da215, type: 3}
    holdSeconds: 4.81
  - text: "\uBA3C\uC800 \uC5B4\uAE08\uB2C8\uC758 \uAE4C\uB9CC \uCDA9\uCE58\uB97C
      \uCE58\uB8CC\uD558\uACE0, \uC774\uC5D0 \uBD99\uC740 \uCE58\uD0DC \uC138\uADE0\uB3C4
      \uC5C6\uC560 \uC918. \uB2E4 \uB05D\uB098\uBA74 \uC74C\uC2DD\uC744 \uC539\uC744
      \uC218 \uC788\uC5B4."
    voice: {fileID: 8300000, guid: 56911c09ddaa01f4bb7cbdcee68eadd8, type: 3}
    holdSeconds: 7.54
  outroLines:
  - text: "\uC798\uAC8C \uC539\uD600 \uCE68\uACFC \uC11E\uC778 \uC74C\uC2DD \uB369\uC5B4\uB9AC\uB97C
      '\uC2DD\uAD34'\uB77C\uACE0 \uD574. \uD600\uAC00 \uC2DD\uAD34\uB97C \uBAA9\uAD6C\uBA4D\uC73C\uB85C
      \uBCF4\uB0B4\uBA74, \uC6B0\uB9AC\uB294 \uADF8 \uC774\uB3D9 \uACBD\uB85C\uB97C
      \uB530\uB77C \uC2DD\uB3C4\uB85C \uAC00 \uBCF4\uC790."
    voice: {fileID: 8300000, guid: a571473e5cafcbb41a0df961048b678a, type: 3}
    holdSeconds: 9.49
  summary: "\uC785\uC740 \uC74C\uC2DD\uC744 \uC774\uB85C \uC798\uAC8C \uBD80\uC218\uACE0(\uAE30\uACC4\uC801
    \uC18C\uD654) \uCE68\uC73C\uB85C \uB179\uB9D0\uC744 \uBD84\uD574\uD558\uB294(\uD654\uD559\uC801
    \uC18C\uD654) \uACF3\uC774\uC5D0\uC694. \uD600\uB294 \uC74C\uC2DD\uC744 \uC11E\uACE0
    \uC0BC\uD0A4\uB3C4\uB85D \uBC00\uC5B4 \uC918\uC694."
  funFacts:
  - "\uC5B4\uB978\uC758 \uC774\uB294 \uBAA8\uB450 32\uAC1C\uC608\uC694."
  - "\uD558\uB8E8\uC5D0 \uCE68\uC774 1~1.5\uB9AC\uD130\uB098 \uB9CC\uB4E4\uC5B4\uC838\uC694."
  - "\uD600\uC5D0\uB294 \uB9DB\uC744 \uB290\uB07C\uB294 '\uBBF8\uB8B0'\uAC00 \uC218\uCC9C
    \uAC1C \uC788\uC5B4\uC694."
  fadeColor: {r: 0.22745098, g: 0.05882353, b: 0.078431375, a: 1}
  ridesCapsule: 0
