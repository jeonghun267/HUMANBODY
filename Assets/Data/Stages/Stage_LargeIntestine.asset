  m_EditorClassIdentifier: Assembly-CSharp::OrganStage
  stageId: LargeIntestine
  displayName: "\uB300\uC7A5"
  sceneName: 05_LargeIntestine
  introLines:
  - text: "\uB300\uC7A5\uC740 \uAE38\uC774 1.5\uBBF8\uD130, \uB0A8\uC740 \uBB3C\uACFC
      \uBBF8\uB124\uB784\uC744 \uD761\uC218\uD574\uC11C \uCC0C\uAEBC\uAE30\uB97C
      \uAD73\uD788\uB294 \uACF3\uC774\uC57C. \uCEA1\uC290\uC5D0\uC11C \uBB3C\uBC29\uC6B8\uACFC
      \uCC0C\uAEBC\uAE30\uC758 \uBCC0\uD654\uB97C \uAD00\uCC30\uD574 \uBCF4\uC790."
    voice: {fileID: 8300000, guid: 39288539574c58e4493464927896b8f3, type: 3}
    holdSeconds: 9.099999
  - text: "\uC5EC\uAE30\uC5D4 \uC218\uC2ED\uC870 \uB9C8\uB9AC\uC758 \uC7A5\uB0B4
      \uC138\uADE0\uC774 \uC0B4\uC544. \uCD08\uB85D\uC0C9 \uC720\uC775\uADE0\uC740
      \uBE44\uD0C0\uBBFC\uC744 \uB9CC\uB4E4\uC5B4 \uC8FC\uACE0, \uBCF4\uB77C\uC0C9
      \uC720\uD574\uADE0\uC740 \uB108\uBB34 \uB9CE\uC544\uC9C0\uBA74 \uBC30\uD0C8\uC774
      \uB098."
    voice: {fileID: 8300000, guid: 022108c24f9086f479a00c1f98845105, type: 3}
    holdSeconds: 8.84
  outroLines:
  - text: "\uAD73\uC5B4\uC9C4 \uCC0C\uAEBC\uAE30\uB294 \uB300\uBCC0\uC774 \uB418\uC5B4
      \uBAB8 \uBC16\uC73C\uB85C \uB098\uAC00. \uC6B0\uB9AC\uB294 \uC5EC\uAE30\uC11C
      \uAD00\uCC30\uC744 \uB9C8\uCE58\uACE0 \uC815\uB9AC \uC0C1\uC601\uAD00\uC73C\uB85C
      \uC774\uB3D9\uD558\uC790!"
    voice: {fileID: 8300000, guid: 6f09d61535a36da458754caa1fa6690b, type: 3}
    holdSeconds: 7.2799997
  summary: "\uB300\uC7A5\uC740 \uBB3C\uC744 \uD761\uC218\uD574 \uCC0C\uAEBC\uAE30\uB97C
    \uB300\uBCC0\uC73C\uB85C \uB9CC\uB4E4\uACE0, \uC7A5\uB0B4 \uC138\uADE0\uC774
    \uB0A8\uC740 \uC601\uC591\uBD84\uC744 \uBD84\uD574\uD558\uBA70 \uBE44\uD0C0\uBBFC\uC744
    \uB9CC\uB4E4\uC5B4\uC694."
  funFacts:
  - "\uC7A5\uB0B4 \uC138\uADE0 \uC218\uB294 \uC6B0\uB9AC \uBAB8 \uC138\uD3EC \uC218\uC640
    \uBE44\uC2B7\uD574\uC694."
  - "\uB300\uBCC0\uC758 \uC57D 30%\uB294 \uC138\uADE0\uC774\uC5D0\uC694."
  - "\uCC44\uC18C\uC758 \uC2DD\uC774\uC12C\uC720\uB294 \uC720\uC775\uADE0\uC758 \uBA39\uC774\uAC00
    \uB3FC\uC694."
  fadeColor: {r: 0.23137255, g: 0.14117648, b: 0.09411765, a: 1}
  ridesCapsule: 1
