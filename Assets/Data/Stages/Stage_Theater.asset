  displayName: "\uC815\uB9AC \uC0C1\uC601\uAD00"
  sceneName: 06_Theater
  introLines:
  - text: "\uBAB8\uC18D \uD0D0\uD5D8\uC744 \uB9C8\uCE58\uACE0 \uC815\uB9AC \uC0C1\uC601\uAD00\uC5D0
      \uB3C4\uCC29\uD588\uC5B4! \uC774\uC81C \uC6B0\uB9AC\uAC00 \uAD00\uCC30\uD55C
      \uC74C\uC2DD\uC758 \uC18C\uD654 \uACFC\uC815\uC744 \uC601\uC0C1\uC73C\uB85C
      \uD55C \uBC88 \uB354 \uC0B4\uD3B4\uBCF4\uC790."
    voice: {fileID: 8300000, guid: 9e1b8d694428aec4c9e001ab08a617f0, type: 3}
    holdSeconds: 8.19
  outroLines:
  - text: "\uC785\uC5D0\uC11C \uB300\uC7A5\uAE4C\uC9C0, \uC74C\uC2DD\uC758 \uC5EC\uC815\uC744
      \uD568\uAED8 \uAD00\uCC30\uD574 \uBD24\uC5B4. \uD0D0\uD5D8\uAC00\uB2F5\uAC8C
      \uC624\uB298 \uBC30\uC6B4 \uAC78 \uAF2D \uAE30\uC5B5\uD574 \uC918! \uC090\uC57D!"
    voice: {fileID: 8300000, guid: 0e10a15095f2bc94b87926e326d52e20, type: 3}
    holdSeconds: 7.1499996
  summary: "\uC785 \u2192 \uC2DD\uB3C4 \u2192 \uC704 \u2192 \uC18C\uC7A5 \u2192 \uB300\uC7A5.
    \uC74C\uC2DD\uC740 \uC798\uAC8C \uCABC\uAC1C\uC9C0\uACE0, \uC601\uC591\uC18C\uB294
    \uD761\uC218\uB418\uACE0, \uCC0C\uAEBC\uAE30\uB294 \uBC16\uC73C\uB85C \uB098\uAC00\uC694."
  funFacts:
  - "\uACE8\uACE0\uB8E8 \uBA39\uACE0 \uAF2D\uAF2D \uC539\uC73C\uBA74 \uC18C\uD654\uAE30\uAD00\uC774
    \uD3B8\uD574\uC838\uC694."
  - "\uBB3C\uC744 \uCDA9\uBD84\uD788 \uB9C8\uC2DC\uBA74 \uB300\uC7A5\uC774 \uC77C\uD558\uAE30
    \uC26C\uC6CC\uC694."
  fadeColor: {r: 0, g: 0, b: 0, a: 1}
  ridesCapsule: 0
