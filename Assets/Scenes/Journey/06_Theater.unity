--- !u!114 &111140927
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 111140925}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eff84f256d0331341a2261a4b8c871c6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::OxQuiz
  questions:
  - text: "\uCE68\uC5D0\uB294 \uB179\uB9D0\uC744 \uBD84\uD574\uD558\uB294 \uD6A8\uC18C\uAC00
      \uB4E4\uC5B4 \uC788\uB2E4."
    answer: 1
    explain: "\uCE68 \uC18D \uC544\uBC00\uB808\uC774\uC2A4\uAC00 \uB179\uB9D0\uC744
      \uC5FF\uB2F9\uC73C\uB85C \uBC14\uAFD4\uC694."
    voice: {fileID: 8300000, guid: 022e889def986174eb5bed31488dd11a, type: 3}
    explainVoice: {fileID: 8300000, guid: f9cb9ba396b5e8240a10419f7ba81e48, type: 3}
  - text: "\uC2DD\uB3C4\uB294 \uC74C\uC2DD\uC744 \uC18C\uD654\uC2DC\uD0A4\uB294 \uACF3\uC774\uB2E4."
    answer: 0
    explain: "\uC2DD\uB3C4\uB294 \uC5F0\uB3D9 \uC6B4\uB3D9\uC73C\uB85C \uC74C\uC2DD\uC744
      \uC704\uB85C \uC62E\uAE30\uAE30\uB9CC \uD574\uC694."
    voice: {fileID: 8300000, guid: b900fba874cbe6648a678cbac2e24366, type: 3}
    explainVoice: {fileID: 8300000, guid: dd83802ba305c8847a5a5ec028b14f99, type: 3}
  - text: "\uC704\uC561\uC740 \uAC15\uD55C \uC0B0\uC131\uC774\uB77C \uC138\uADE0\uC744
      \uC5C6\uC560 \uC900\uB2E4."
    answer: 1
    explain: "\uAC15\uD55C \uC704\uC0B0\uC774 \uC74C\uC2DD\uACFC \uD568\uAED8 \uB4E4\uC5B4\uC628
      \uC138\uADE0\uC744 \uC5C6\uC560\uC694."
    voice: {fileID: 8300000, guid: 2b7d35d5c83fee743a15a4804d93644a, type: 3}
    explainVoice: {fileID: 8300000, guid: ca9366bcfae6714428ce7817e3886737, type: 3}
  - text: "\uC601\uC591\uC18C\uB294 \uB300\uBD80\uBD84 \uB300\uC7A5\uC5D0\uC11C \uD761\uC218\uB41C\uB2E4."
    answer: 0
    explain: "\uC601\uC591\uC18C\uB294 \uB300\uBD80\uBD84 \uC18C\uC7A5\uC758 \uC735\uD138\uC5D0\uC11C
      \uD761\uC218\uB418\uACE0, \uB300\uC7A5\uC740 \uC8FC\uB85C \uBB3C\uC744 \uD761\uC218\uD574\uC694."
    voice: {fileID: 8300000, guid: 9f1a5e236fcd87e4dbf12466e2cf307f, type: 3}
    explainVoice: {fileID: 8300000, guid: 17494dbd56e9d43489d869f3de791840, type: 3}
  - text: "\uC720\uC775\uADE0\uC740 \uC2DD\uC774\uC12C\uC720\uB97C \uBA39\uACE0 \uC6B0\uB9AC
      \uBAB8\uC744 \uB3D5\uB294\uB2E4."
    answer: 1
    explain: "\uCC44\uC18C\uC758 \uC2DD\uC774\uC12C\uC720\uB294 \uC720\uC775\uADE0\uC758
      \uBA39\uC774\uC608\uC694."
    voice: {fileID: 8300000, guid: f90b871b8c753254abc6413ed118af91, type: 3}
    explainVoice: {fileID: 8300000, guid: 02932fedee39a904694100774207ef79, type: 3}
  panel: {fileID: 1044139998}
