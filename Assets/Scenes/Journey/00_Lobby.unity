  m_Script: {fileID: 11500000, guid: 676ce23c6f9500045a484d1b6d5a30a0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HospitalNpc
  npcName: "\uC758\uC0AC \uC120\uC0DD\uB2D8"
  nodes:
  - text: "\uC5B4\uC11C \uC640\uC694. \uC624\uB298 \uD568\uAED8 \uBAB8\uC18D\uC744
      \uC0B4\uD3B4\uBCFC \uC758\uC0AC\uC608\uC694. \uBA3C\uC800 \uBAB8 \uC2A4\uCE94\uC744
      \uBCFC\uAE4C\uC694?"
    voice: {fileID: 8300000, guid: 67d14470aac32914f85a8bb9249cfa92, type: 3}
    next: -1
    choices:
    - label: "\uB124, \uBCF4\uC5EC \uC8FC\uC138\uC694"
      next: 1
    - label: "\uBAB8 \uC2A4\uCE94\uC774 \uBB50\uC608\uC694?"
      next: 2
    onEnter:
      m_PersistentCalls:
        m_Calls: []
  - text: "\uBE68\uAC1B\uAC8C \uBE5B\uB098\uB294 \uACF3\uC774 \uC544\uD508 \uACF3\uC774\uC5D0\uC694.
      \uCE58\uB8CC \uAD11\uC120\uC73C\uB85C \uD558\uB098\uC529 \uAC00\uB9AC\uD0A4\uACE0
      \uBC29\uC544\uC1E0\uB97C \uB2F9\uACA8 \uBCF4\uC138\uC694."
    voice: {fileID: 8300000, guid: 52eef2eae6ee70b4f853437b403b9f99, type: 3}
    next: -1
    choices: []
    onEnter:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 1697453371}
          m_TargetAssemblyTypeName: GermBlaster, Assembly-CSharp
          m_MethodName: Begin
          m_Mode: 0
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: 
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
  - text: "\uBAB8 \uC2A4\uCE94\uC740 \uBAB8 \uC548\uC744 \uC0AC\uC9C4\uCC98\uB7FC
      \uB4E4\uC5EC\uB2E4\uBCF4\uB294 \uC7A5\uCE58\uC608\uC694. \uC544\uD508 \uACF3\uC740
      \uBE68\uAC1B\uAC8C \uBE5B\uB098\uC694."
    voice: {fileID: 8300000, guid: 6e741b7b6e702124a9e7fc316b15360a, type: 3}
    next: 1
    choices: []
    onEnter:
      m_PersistentCalls:
        m_Calls: []
  - text: "\uC6D0\uC778\uC744 \uB2E4 \uCC3E\uC558\uC5B4\uC694. \uCD08\uC18C\uD615
      \uC7A0\uC218\uC815\uC744 \uD0C0\uBA74 \uC544\uC8FC \uC791\uC544\uC838\uC11C
      \uC785\uC18D\uC73C\uB85C \uB4E4\uC5B4\uAC00\uC694. \uAC00\uB294 \uB3D9\uC548
      \uC548\uB0B4 \uBC29\uC1A1\uC774 \uAE38\uC744 \uC54C\uB824 \uC904 \uAC70\uC608\uC694."
    voice: {fileID: 8300000, guid: a7457def6998c2545a1a101091c256b3, type: 3}
    next: -1
    choices:
    - label: "\uCD9C\uBC1C\uD560\uAC8C\uC694!"
      next: 4
    - label: "\uC7A0\uC218\uC815\uC740 \uC548\uC804\uD55C\uAC00\uC694?"
      next: 5
    onEnter:
      m_PersistentCalls:
        m_Calls: []
  - text: "\uC7A0\uC218\uC815 \uD0D1\uC2B9\uAD6C\uB85C \uAC00\uC11C \uC606\uC5D0
      \uC788\uB294 \uCD9C\uBC1C \uBC84\uD2BC\uC744 \uB20C\uB7EC \uC8FC\uC138\uC694.
      \uBAB8\uC18D\uC5D0\uC11C \uC9C1\uC811 \uCE58\uB8CC\uD574 \uBD10\uC694!"
    voice: {fileID: 8300000, guid: 8a8ebec07350a444eb8be2ea4f8579a3, type: 3}
    next: -1
    choices: []
    onEnter:
      m_PersistentCalls:
        m_Calls: []
  - text: "\uADF8\uB7FC\uC694. \uD2BC\uD2BC\uD55C \uC720\uB9AC\uB85C \uAC10\uC2F8\uC838
      \uC788\uACE0, \uCE58\uB8CC\uAC00 \uB05D\uB098\uBA74 \uB2E4\uC2DC \uBCD1\uC6D0\uC73C\uB85C
      \uB3CC\uC544\uC640\uC694."
    voice: {fileID: 8300000, guid: 07af28b6822b2a3478d06693d085cf21, type: 3}
    next: 4
    choices: []
    onEnter:
      m_PersistentCalls:
        m_Calls: []
