--- !u!114 &1132732122
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1132732120}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 676ce23c6f9500045a484d1b6d5a30a0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HospitalNpc
  npcName: "\uAC04\uD638\uC0AC"
  nodes:
  - text: "\uC548\uB155\uD558\uC138\uC694! \uBCD1\uC6D0\uC5D0 \uC628 \uAC78 \uD658\uC601\uD574\uC694.
      \uC5B4\uB514\uAC00 \uBD88\uD3B8\uD574\uC11C \uC624\uC168\uC5B4\uC694?"
    voice: {fileID: 8300000, guid: dfd7f266186f16d43987b4025d345c38, type: 3}
    next: -1
    choices:
    - label: "\uC774\uAC00 \uC2DC\uB824\uC694"
      next: 1
    - label: "\uBC30\uAC00 \uC544\uD30C\uC694"
      next: 2
    - label: "\uB458 \uB2E4 \uC544\uD30C\uC694"
      next: 3
    onEnter:
      m_PersistentCalls:
        m_Calls: []
  - text: "\uC774\uAC00 \uC2DC\uB9AC\uBA74 \uCDA9\uCE58\uC77C \uC218 \uC788\uC5B4\uC694.
      \uC758\uC0AC \uC120\uC0DD\uB2D8\uAED8 \uC9C4\uCC30\uBC1B\uC544 \uBCFC\uAE4C\uC694?"
    voice: {fileID: 8300000, guid: f7774ef047f21ce4fb0897f4f5b396c8, type: 3}
    next: 4
    choices: []
    onEnter:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 2112452458}
          m_TargetAssemblyTypeName: ClinicMonitor, Assembly-CSharp
          m_MethodName: SetSymptom
          m_Mode: 5
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: 
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: "\uC774\uAC00 \uC2DC\uB824\uC694"
            m_BoolArgument: 0
          m_CallState: 2
  - text: "\uBC30\uAC00 \uC544\uD504\uAD70\uC694. \uC18C\uD654\uAC00 \uC798 \uC548
      \uB418\uB294 \uAC78 \uC218\uB3C4 \uC788\uC5B4\uC694. \uC758\uC0AC \uC120\uC0DD\uB2D8\uC774
      \uBAB8\uC18D\uC744 \uC0B4\uD3B4\uBD10 \uC8FC\uC2E4 \uAC70\uC608\uC694."
    voice: {fileID: 8300000, guid: 8701c7ff5d153164fb3b8096094818d8, type: 3}
    next: 4
    choices: []
    onEnter:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 2112452458}
          m_TargetAssemblyTypeName: ClinicMonitor, Assembly-CSharp
          m_MethodName: SetSymptom
          m_Mode: 5
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: 
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: "\uBC30\uAC00 \uC544\uD30C\uC694"
            m_BoolArgument: 0
          m_CallState: 2
  - text: "\uC774\uB3C4 \uC2DC\uB9AC\uACE0 \uBC30\uB3C4 \uC544\uD504\uB2E4\uB2C8
      \uD798\uB4E4\uC5C8\uACA0\uC5B4\uC694. \uC624\uB298 \uBAB8\uC18D\uC744 \uAF3C\uAF3C\uD788
      \uC0B4\uD3B4\uBD10\uC694."
    voice: {fileID: 8300000, guid: 5ea61fd131533cb4ba727eb88cb7cdae, type: 3}
    next: 4
    choices: []
    onEnter:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 2112452458}
          m_TargetAssemblyTypeName: ClinicMonitor, Assembly-CSharp
          m_MethodName: SetSymptom
          m_Mode: 5
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: 
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: "\uC774\uB3C4 \uC2DC\uB9AC\uACE0\n\uBC30\uB3C4 \uC544\uD30C\uC694"
            m_BoolArgument: 0
          m_CallState: 2
  - text: "\uBAB8 \uC2A4\uCE94 \uC624\uB978\uCABD\uC5D0 \uACC4\uC2E0 \uC758\uC0AC
      \uC120\uC0DD\uB2D8\uAED8 \uAC00\uC11C \uB9D0\uC744 \uAC78\uC5B4 \uBCF4\uC138\uC694.
      \uC190\uC73C\uB85C \uAC00\uB9AC\uD0A4\uACE0 \uBC29\uC544\uC1E0\uB97C \uB2F9\uAE30\uBA74
      \uB3FC\uC694."
    voice: {fileID: 8300000, guid: 6edfb061b19449048b32b71b9d0588e2, type: 3}
    next: -1
    choices: []
    onEnter:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 1132732122}
          m_TargetAssemblyTypeName: HospitalNpc, Assembly-CSharp
          m_MethodName: ShowGoal
          m_Mode: 5
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: 
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: "\uBAB8 \uC2A4\uCE94 \uC624\uB978\uCABD\uC758 \uC758\uC0AC
              \uC120\uC0DD\uB2D8\uAED8 \uB9D0\uC744 \uAC78\uC5B4 \uBCF4\uC138\uC694"
            m_BoolArgument: 0
          m_CallState: 2
  - text: "\uAD81\uAE08\uD55C \uAC8C \uC788\uC73C\uBA74 \uC758\uC0AC \uC120\uC0DD\uB2D8\uAED8
      \uBB3C\uC5B4\uBCF4\uC138\uC694. \uC800\uB294 \uC5EC\uAE30 \uC788\uC744\uAC8C\uC694!"
    voice: {fileID: 8300000, guid: ad6b6f6c6a12f4140902f6a69fb34d5b, type: 3}
    next: -1
    choices: []
    onEnter:
      m_PersistentCalls:
        m_Calls: []
